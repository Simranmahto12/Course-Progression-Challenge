# Course Progression Tracker - Environment Configuration
# Mirai School of Technology (MSOT)

# Port Configuration
PORT=5001
FRONTEND_PORT=3000

# Database Connection (SQLite by default for zero-friction local run; PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL for Docker/Production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_progression?schema=public"

# Authentication
JWT_SECRET=mirai_msot_progression_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Notification Service (Local simulated mode records notifications to DB; set smtp for external)
NOTIFICATION_PROVIDER=simulated
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply-progress@mirai.edu.in"

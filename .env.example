# ==============================================================================
# MIRAI SCHOOL OF TECHNOLOGY (MSOT) — COURSE PROGRESSION PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=mirai_msot_course_progression_jwt_secret_2026
JWT_EXPIRES_IN=7d
DEMO_OTP=123456

# Database (Self-Contained SQLite with WAL Mode)
DATABASE_FILE=./database.sqlite

# ------------------------------------------------------------------------------
# 1. WhatsApp & Telegram Webhook Session Logging (Stretch Goal 1)
# ------------------------------------------------------------------------------
# Meta Graph API App Secret for HMAC SHA-256 Webhook Verification
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=mirai_webhook_secret

# Telegram Bot API Secret Token Header (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_SECRET=your_telegram_bot_secret_token_here

# ------------------------------------------------------------------------------
# 2. AI Weekly Grounded Campus Summary (Stretch Goal 2)
# ------------------------------------------------------------------------------
# Enable or disable AI summary feature (defaults to true)
AI_SUMMARY_ENABLED=true

# Optional external LLM API keys for formatting summaries.
# Note: Zero student PII is transmitted. If omitted, the platform uses its local
# deterministic rule-based grounding engine with zero external dependencies.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Google Calendar & Google Sheets API Integration (Stretch Goal 3 & 5)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client credentials (Authorized redirect: /api/calendar-sync/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Service Account JSON string or file path for direct Google Sheets writes
GOOGLE_SERVICE_ACCOUNT_KEY=

# Set to true for local testing of calendar sync and Google Sheets export
MOCK_CALENDAR_PROVIDER=true

# ------------------------------------------------------------------------------
# 4. Microsoft Outlook / Office 365 Calendar Integration (Stretch Goal 3)
# ------------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) Client credentials with Calendars.ReadWrite permission
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=


// Prisma schema for MSOT Course Progression Tracker
// Optimized for SQLite (local zero-setup) and PostgreSQL compatible

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("FACULTY") // ADMIN, CAMPUS_MANAGER, FACULTY, STUDENT
  campusId     String?
  campus       Campus?       @relation(fields: [campusId], references: [id])
  batchId      String?
  batch        Batch?        @relation(fields: [batchId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  subjectsTaught   Subject[]
  timetableEntries TimetableEntry[]
  scheduledSessions ScheduledSession[]
  sessionLogs      SessionLog[]
  alertsReceived   Alert[]
  auditActions     SessionAuditLog[]
}

model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  batches          Batch[]
  subjects         Subject[]
  timetableEntries TimetableEntry[]
  scheduledSessions ScheduledSession[]
  holidays         HolidayCalendar[]
}

model Track {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batches  Batch[]
  subjects Subject[]
}

model AcademicYear {
  id        String     @id @default(cuid())
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  semesters Semester[]
}

model Semester {
  id               String       @id @default(cuid())
  name             String
  academicYearId   String
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semesterNumber   Int          @default(5)
  startDate        DateTime
  endDate          DateTime
  targetFinishDate DateTime
  saturdayRule     String       @default("SECOND_FOURTH_SATURDAY") // ALL_SATURDAYS, NO_SATURDAYS, SECOND_FOURTH_SATURDAY
  isCurrent        Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  batches     Batch[]
  subjects    Subject[]
  examWindows ExamWindow[]
}

model Batch {
  id         String   @id @default(cuid())
  name       String   @unique
  campusId   String
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students          User[]
  subjects          Subject[]
  timetableEntries  TimetableEntry[]
  scheduledSessions ScheduledSession[]
  holidays          HolidayCalendar[]
}

model ExamWindow {
  id          String   @id @default(cuid())
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  name        String   // SESSIONAL_1, SESSIONAL_2, MID_TERM, PUT, END_TERM
  displayName String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HolidayCalendar {
  id                  String   @id @default(cuid())
  date                DateTime
  title               String
  type                String   @default("HOLIDAY") // HOLIDAY, EVENT, EXAM_BLACKOUT
  campusId            String?
  campus              Campus?  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  batchId             String?
  batch               Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  isTeachingSuspended Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([date])
}

model Subject {
  id               String   @id @default(cuid())
  code             String
  name             String
  campusId         String
  campus           Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  trackId          String
  track            Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  semesterId       String
  semester         Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  facultyId        String?
  faculty          User?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  plannedHours     Float    @default(0)
  targetFinishDate DateTime
  color            String?  @default("#2563eb")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  topics            Topic[]
  timetableEntries  TimetableEntry[]
  scheduledSessions ScheduledSession[]
  sessionLogs       SessionLog[]
  alerts            Alert[]

  @@unique([code, campusId, batchId])
}

model Topic {
  id                   String    @id @default(cuid())
  subjectId            String
  subject              Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit                 String    // e.g. "Unit 1"
  sequence             Int       // 1, 2, 3...
  name                 String
  description          String?
  plannedHours         Float
  examScopes           String    // comma separated: "MID_TERM,END_TERM"
  prerequisites        String?
  status               String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  completionPercentage Float     @default(0.0)
  coveredHours         Float     @default(0.0)
  plannedDate          DateTime?
  actualDate           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([subjectId, sequence])
}

model TimetableEntry {
  id            String   @id @default(cuid())
  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId     String
  faculty       User     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  weekday       Int      // 1 = Mon, 2 = Tue, 3 = Wed, 4 = Thu, 5 = Fri, 6 = Sat
  startTime     String   // "09:00"
  endTime       String   // "10:00"
  durationHours Float    // 1.0
  roomNumber    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scheduledSessions ScheduledSession[]
}

model ScheduledSession {
  id               String          @id @default(cuid())
  timetableEntryId String?
  timetableEntry   TimetableEntry? @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  subjectId        String
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId        String
  faculty          User            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  batchId          String
  batch            Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  campusId         String
  campus           Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sessionDate      DateTime        // calendar date
  startTime        String
  endTime          String
  durationHours    Float           @default(1.0)
  status           String          @default("SCHEDULED") // SCHEDULED, COMPLETED, IN_PROGRESS, SKIPPED, MERGED, CANCELLED
  hasLog           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  sessionLog       SessionLog?
  alerts           Alert[]

  @@unique([subjectId, sessionDate, startTime])
  @@index([sessionDate, facultyId])
}

model SessionLog {
  id                 String           @id @default(cuid())
  scheduledSessionId String           @unique
  scheduledSession   ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  subjectId          String
  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId          String
  faculty            User             @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  date               DateTime
  status             String           // COMPLETED, IN_PROGRESS, SKIPPED, MERGED, CANCELLED
  actualHours        Float
  topicsCovered      String           // JSON string of [{topicId, topicName, completionPercentage, hoursLogged}]
  whatWasCovered     String?
  whatWasLeftOver    String?
  carryForwardAction String?
  classworkStatus    String?          @default("NONE") // GIVEN, COLLECTED, REVIEWED, NONE
  notes              String?
  loggedAt           DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  auditLogs          SessionAuditLog[]
}

model SessionAuditLog {
  id              String      @id @default(cuid())
  sessionLogId    String
  sessionLog      SessionLog  @relation(fields: [sessionLogId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedByUser   User        @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)
  action          String      // "CREATE", "UPDATE", "OVERRIDE"
  previousState   String?     // JSON
  newState        String      // JSON
  reason          String?
  createdAt       DateTime    @default(now())
}

model Alert {
  id                 String      @id @default(cuid())
  scheduledSessionId String
  scheduledSession   ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  subjectId          String
  subject            Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  recipientUserId    String
  recipientUser      User        @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type               String      // FACULTY_REMINDER, CAMPUS_MANAGER_ESCALATION
  title              String
  message            String
  status             String      @default("PENDING") // PENDING, SENT, ACKNOWLEDGED, RESOLVED
  hoursUnlogged      Float       @default(0)
  scheduledDate      DateTime
  sentAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  deliveryLogs       NotificationDeliveryLog[]

  @@unique([scheduledSessionId, type])
  @@index([recipientUserId, status])
}

model NotificationDeliveryLog {
  id             String   @id @default(cuid())
  alertId        String
  alert          Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel        String   // "IN_APP", "EMAIL_SIMULATED", "EMAIL_SMTP"
  recipientEmail String
  payload        String
  sentAt         DateTime @default(now())
}

model SystemSettings {
  id                   String   @id @default("default-settings")
  onTrackThreshold     Float    @default(1.15)
  tightThreshold       Float    @default(1.00)
  defaultSaturdayRule  String   @default("SECOND_FOURTH_SATURDAY")
  academicYearName     String   @default("2026-2027")
  updatedAt            DateTime @updatedAt
}
